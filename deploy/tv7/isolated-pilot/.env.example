# TEMPLATE, NÃO É CREDENCIAL. O preflight real recusa SUBSTITUIR.
# Use somente .env desta pasta, modo 600; não use o .env da raiz/legado.
NEXT_PUBLIC_SUPABASE_URL=https://SUBSTITUIR.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUBSTITUIR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUIR_SERVICE_ROLE_KEY
# Connect > Session pooler (5432), IPv4; senha percent-encoded; TLS obrigatório.
SUPABASE_DB_URL=postgresql://postgres.SUBSTITUIR:SUBSTITUIR@SUBSTITUIR.pooler.supabase.com:5432/postgres?sslmode=require

# Segredos independentes: 32 bytes aleatórios em base64 para as três cifras.
CPF_ENCRYPTION_KEY=SUBSTITUIR_BASE64_32_BYTES
AI_CRED_AES_KEY=SUBSTITUIR_BASE64_32_BYTES
WAHA_BYO_ENCRYPTION_KEY=SUBSTITUIR_BASE64_32_BYTES
# 32 bytes aleatórios em hexadecimal para os demais.
INTERNAL_SECRET=SUBSTITUIR_HEX_64
IMPERSONATE_COOKIE_SECRET=SUBSTITUIR_HEX_64
LGPD_SIGNING_KEY=SUBSTITUIR_HEX_64
WAHA_API_KEY=SUBSTITUIR_HEX_64
WAHA_HMAC_SECRET=SUBSTITUIR_HEX_64
SRH_TOKEN=SUBSTITUIR_HEX_64
# SHA512 hexadecimal de WAHA_API_KEY, sem prefixo sha512: (Compose acrescenta).
WAHA_API_KEY_SHA512=SUBSTITUIR_SHA512_128

# Opcionais para boot; configurar ao menos um provedor antes de testar IA.
# Também podem ser cadastradas pela UI nas credenciais da organização.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Declarações do operador, NÃO sondas de banco. Só mudar após preparar/verificar
# o projeto exclusivo, baseline da release, Auth/Storage/Realtime e dono.
PILOT_SUPABASE_READY=no
PILOT_SCHEMA_RELEASE=SUBSTITUIR_APOS_VALIDAR_1.60.0
